rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for role checks
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserRole() {
      // Access the role field from the users collection
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }
    
    function isCore() {
      return isSignedIn() && (getUserRole() == 'core' || getUserRole() == 'admin');
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.role == 'member';

      allow update: if isSignedIn() && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
                    && (
                      resource.data.role != 'member' || 
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone', 'collegeEmail', 'course', 'branch', 'year'])
                    );

      allow read, write: if isAdmin();
    }

    // Public Profiles Collection (Denormalized safe data)
    match /public_profiles/{userId} {
      allow read: if true;
      allow create: if (isSignedIn() && request.auth.uid == userId)
                    && request.resource.data.role == 'member';
      allow update: if (isSignedIn() && request.auth.uid == userId)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow write: if isAdmin();
    }

    // Events Collection & Registration Subcollections
    match /events/{eventId} {
      allow read: if resource.data.status in ['published', 'closed'] || isCore();
      allow write: if isAdmin();
      allow update: if isCore() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gallery']);
      
      match /registrations/{registrationId} {
        // Users can read their own registrations
        allow read: if isSignedIn() && request.auth.uid == registrationId;
        
        // Core and Admins can read all registrations
        allow read: if isCore();
        
        // Users can create/delete their own registration
        allow create: if isSignedIn() && request.auth.uid == registrationId
                      && get(/databases/$(database)/documents/events/$(eventId)).data.status == 'published'
                      && get(/databases/$(database)/documents/events/$(eventId)).data.get('registrationOpen', true) == true
                      && request.resource.data.keys().hasOnly(['eventId', 'eventTitle', 'userId', 'registeredAt', 'userProfile', 'teamName', 'teamMembers'])
                      && (!('teamMembers' in request.resource.data) || request.resource.data.teamMembers.size() <= 10);
        allow delete: if isSignedIn() && request.auth.uid == registrationId;
        
        // Admins can update/delete any registration
        allow update, delete: if isAdmin();
      }
    }

    // Profile Edit Requests Collection
    match /profile_edit_requests/{requestId} {
      allow read: if isSignedIn() && request.auth.uid == requestId;
      allow create: if isSignedIn() && request.auth.uid == requestId
                    && request.resource.data.field in ['phone', 'collegeEmail', 'course', 'branch', 'year'];
      allow read, write: if isAdmin();
    }
    
    // Site Content (FAQs, etc.)
    match /site_content/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Gallery (if separate from events)
    match /gallery/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
